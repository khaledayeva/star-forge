            "package_surface": ".app.json",
            "app_id": "asdk_app_69fdb9081018819193707354f21b366e",
            "desktop_credentials": "chatgpt-app-connection",
            "cli_add_command": "codex mcp add mobbin --url https://api.mobbin.com/mcp",
